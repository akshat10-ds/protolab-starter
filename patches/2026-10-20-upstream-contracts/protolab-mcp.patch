diff --git a/scripts/check-template-contracts.mjs b/scripts/check-template-contracts.mjs
--- /dev/null
+++ b/scripts/check-template-contracts.mjs
@@ -0,0 +1,57 @@
+/** Run after bundle + template generation and installing the template's dev dependencies. */
+import { createRequire } from 'node:module';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const template = fileURLToPath(new URL('../template/ink-starter/', import.meta.url));
+const require = createRequire(path.join(template, 'package.json'));
+const ts = require('typescript');
+const configFile = ts.readConfigFile(path.join(template, 'tsconfig.json'), ts.sys.readFile);
+if (configFile.error) throw new Error(ts.flattenDiagnosticMessageText(configFile.error.messageText, '\n'));
+const config = ts.parseJsonConfigFileContent(configFile.config, ts.sys, template);
+const probePath = path.join(template, 'src/__public_api_contracts__.tsx');
+const probe = `
+import * as React from 'react';
+import { Button, IconButton, FilterTag, Text, Tooltip, Popover, Dropdown, Portal } from '@/design-system';
+import type { DataTableColumn, LocalNavProps, DropdownItemProps } from '@/design-system';
+import type { GlobalNavProps } from '@/design-system/5-patterns/GlobalNav';
+const columns: DataTableColumn<{ id: string }>[] = [{ key: 'id', header: 'ID' }];
+const nav: LocalNavProps = { sections: [] };
+const globalNav: GlobalNavProps = {};
+const items: DropdownItemProps[] = [{ label: 'Open' }];
+const valid = <>
+  <Button kind="primary">Save</Button>
+  <IconButton icon="close" variant="tertiary" aria-label="Close" />
+  <FilterTag label="Status" ref={React.createRef<HTMLButtonElement>()} />
+  <FilterTag label="Status" dismissible ref={React.createRef<HTMLDivElement>()} />
+  <Tooltip text="Help"><Button>Help</Button></Tooltip>
+  <Popover content="Details"><Button>Details</Button></Popover>
+  <Dropdown items={items}><Button>Actions</Button></Dropdown>
+</>;
+// @ts-expect-error Button uses kind.
+const invalidButton = <Button variant="primary">Save</Button>;
+// @ts-expect-error IconButton uses variant.
+const invalidIconButton = <IconButton icon="close" kind="tertiary" aria-label="Close" />;
+// @ts-expect-error Text uses size.
+const invalidText = <Text variant="body">Copy</Text>;
+// @ts-expect-error FilterTag cannot forward an SVG element ref.
+const invalidRef = <FilterTag label="Status" ref={React.createRef<SVGSVGElement>()} />;
+void [Portal, columns, nav, globalNav, valid, invalidButton, invalidIconButton, invalidText, invalidRef];
+`;
+const host = ts.createCompilerHost(config.options);
+const readFile = host.readFile.bind(host);
+const fileExists = host.fileExists.bind(host);
+host.readFile = file => file === probePath ? probe : readFile(file);
+host.fileExists = file => file === probePath || fileExists(file);
+const program = ts.createProgram([...config.fileNames, probePath], { ...config.options, noEmit: true }, host);
+const diagnostics = [...config.errors, ...ts.getPreEmitDiagnostics(program)];
+if (diagnostics.length) {
+  process.stderr.write(ts.formatDiagnosticsWithColorAndContext(diagnostics, {
+    getCanonicalFileName: file => file,
+    getCurrentDirectory: () => template,
+    getNewLine: () => '\n',
+  }));
+  process.exitCode = 1;
+} else {
+  console.log('Generated template and public API contracts pass.');
+}
