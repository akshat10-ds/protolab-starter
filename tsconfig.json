{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@ink": [
        "./src/design-system"
      ],
      "@ink/*": [
        "./src/design-system/*"
      ],
      "@ai": [
        "./src/ai-system"
      ],
      "@ai/*": [
        "./src/ai-system/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.figma.ts"
  ]
}